# PostgreSQL connection string (e.g. from Neon)
DATABASE_URL=postgresql://user:password@ep-xyz.aws.neon.tech/neondb?sslmode=require

# JWT Secret for authentication tokens
JWT_SECRET=your_jwt_secret_key

# Google OAuth Client ID (from console.cloud.google.com)
GOOGLE_CLIENT_ID=

# AI Provider (Groq API key from console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
OPENAI_API_KEY=

# Stripe Billing (Secret key from dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Allowed frontend URL(s) for CORS and Stripe redirects (comma-separated if multiple)
FRONTEND_URL=http://localhost:5173
PORT=3000

